# Copy to .env and change the password. Used by docker-compose.yml.
POSTGRES_DB=site
POSTGRES_USER=site
POSTGRES_PASSWORD=change-me

# HTTPS for visitors. Set your domain (its DNS must point at this server, ports 80 and
# 443 open) and an email for Let's Encrypt expiry notices. Leave DOMAIN empty to use a
# self-signed certificate (browsers will warn).
DOMAIN=
ACME_EMAIL=
